<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.KometaThemes</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!-- Public members of the plugin are documented where the name does not say it all; requiring a
         comment on every DTO property only produced restatements of the property name. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A class library does not copy package assemblies to its output by default. The YouTube
         extractor is not part of the Jellyfin server, so its assemblies must be in the output to be
         packed. The Jellyfin packages are excluded below, so only the extractor lands there. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the server's API but never ship its assemblies: ExcludeAssets=runtime keeps
         them out of the output folder, PrivateAssets keeps them from flowing to consumers. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.KometaThemes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed YouTube extractor, so the import works without an external binary. Its assembly and
         those of its two dependencies are packed with the plugin; see the release archive. -->
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Web\**\*" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\**\*.js;Web\**\*.css;Web\**\*.png;Web\**\*.svg" />
  </ItemGroup>

</Project>
